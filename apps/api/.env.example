PORT=8787
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
# Computer Vision / multi-service resource (Speech key alone does not unlock OCR)
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=
# Optional if endpoint omitted: AZURE_VISION_REGION=
OPENAI_API_KEY=
# Optional OpenAI-compatible host (Ollama: http://127.0.0.1:11434/v1, DeepSeek: https://api.deepseek.com/v1)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Cam OCR silent fallback (calligraphy / foil). Empty MODEL = fallback off.
# Same API key/base as OPENAI_* by default. Example: deepseek-v4-flash-vision-exp
OPENAI_VISION_API_KEY=
OPENAI_VISION_BASE_URL=
OPENAI_VISION_MODEL=
# words.hk is non-commercial — leave both at 0 for paid/ad-supported deploys
YUE_ALLOW_NONCOMMERCIAL_DICTS=0
YUE_ENABLE_WORDSHK=0
# Local dev / private testing: 1 = pro-like limits, no login, no metering.
# Production (Vercel): set YUE_OPEN_MODE=0 and YUE_REQUIRE_LOGIN=1 (see vercel.json).
YUE_OPEN_MODE=1
# Require sign-in before using the app when open mode is off.
YUE_REQUIRE_LOGIN=1
YUE_FREE_LIVE_MINUTES=60
# Free plan hard cap for tap-to-play TTS (blocks when exhausted).
YUE_FREE_TTS_CHARS=30000
YUE_FREE_CAMERA_MINUTES=60
YUE_FREE_DOCS_PAGES=40
YUE_FREE_ALLOW_LIVE=1
YUE_FREE_ALLOW_TTS=1
YUE_FREE_ALLOW_CAMERA=1
YUE_GUEST_LIVE_MINUTES=0
# Family plan (legacy YUE_PRO_* still accepted)
YUE_FAMILY_CAMERA_MINUTES=480
YUE_FAMILY_LIVE_MINUTES=480
YUE_FAMILY_DOCS_PAGES=400
# Retained for reference; Family/Business TTS is unlimited in entitlements (admin shows 0 cap).
YUE_FAMILY_TTS_CHARS=200000
# Business plan (legacy YUE_MAX_* / STRIPE_PRICE_MAX_* still accepted)
YUE_BUSINESS_LIVE_MINUTES=2400
YUE_BUSINESS_TTS_CHARS=500000
# Public app URL for login/upgrade links and Stripe redirects
YUE_APP_URL=http://localhost:5173
# Supabase (API uses service role; web uses anon key via VITE_* or runtime /api/auth-config)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=
# Same value as VITE_SUPABASE_ANON_KEY — lets the API hand the public key to the web app
SUPABASE_ANON_KEY=
# Stripe Checkout + webhook (legacy STRIPE_PRICE_PRO_* still accepted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY_MONTH=
STRIPE_PRICE_FAMILY_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
# Legacy Stripe price env names (STRIPE_PRICE_PRO_*, STRIPE_PRICE_MAX_*) still accepted
# Comma-separated admin emails for #/admin (case-insensitive)
YUE_ADMIN_EMAILS=
# Admin email alerts (Resend) — sign-ups & upgrades
RESEND_API_KEY=
# Resend Audience id — Dashboard → Audiences (contacts sync on sign-up & sign-in)
RESEND_AUDIENCE_ID=
# Verified sender in Resend — must include @:  Name <noreply@yourdomain.com>
# Wrong: JyutTranslate <noreply.yourdomain.com>  (domain without @)
# Right: JyutTranslate <noreply@yourdomain.com>  (or onboarding@resend.dev for tests)
YUE_NOTIFY_FROM=
# Support / Reply-To (Cloudflare Email Routing). Default: JyutTranslate Help <help@mail.jyuttranslate.com>
# Does not need to match the Resend From domain — replies go to your Help inbox.
YUE_SUPPORT_FROM=JyutTranslate Help <help@mail.jyuttranslate.com>
# Optional — defaults to YUE_ADMIN_EMAILS
YUE_ADMIN_NOTIFY_EMAILS=
# Secret for Supabase Database Webhook fallback (optional — many projects lack supabase_functions)
YUE_NOTIFY_WEBHOOK_SECRET=
# Supabase Auth Hook secret (Authentication → Hooks → Before user created) — recommended
SUPABASE_AUTH_HOOK_SECRET=
# Send Email hook (user confirm / magic link / recovery) — separate secret from above
SUPABASE_SEND_EMAIL_HOOK_SECRET=
