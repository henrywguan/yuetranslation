PORT=8787
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
OPENAI_API_KEY=
# Optional OpenAI-compatible host (Ollama: http://127.0.0.1:11434/v1, DeepSeek: https://api.deepseek.com/v1)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# words.hk is non-commercial — leave both at 0 for paid/ad-supported deploys
YUE_ALLOW_NONCOMMERCIAL_DICTS=0
YUE_ENABLE_WORDSHK=0
# Local dev / private testing: 1 = pro-like limits, no login, no metering.
# Production launch: set YUE_OPEN_MODE=0 on Vercel when auth + billing go live.
YUE_OPEN_MODE=1
# Require sign-in for live mic when open mode is off.
YUE_REQUIRE_LOGIN=0
YUE_FREE_LIVE_MINUTES=20
YUE_FREE_TTS_CHARS=0
YUE_FREE_ALLOW_LIVE=1
YUE_FREE_ALLOW_TTS=0
YUE_GUEST_LIVE_MINUTES=0
YUE_PRO_LIVE_MINUTES=600
YUE_PRO_TTS_CHARS=200000
YUE_MAX_LIVE_MINUTES=2400
YUE_MAX_TTS_CHARS=500000
# Public app URL for login/upgrade links and Stripe redirects
YUE_APP_URL=http://localhost:5173
# Supabase (API uses service role; web uses anon key via VITE_*)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=
# Stripe Checkout + webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_MAX_MONTH=
STRIPE_PRICE_MAX_YEAR=
