PORT=8787
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
# Computer Vision / multi-service resource (Speech key alone does not unlock OCR)
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=
# Optional if endpoint omitted: AZURE_VISION_REGION=
OPENAI_API_KEY=
# Optional OpenAI-compatible host (Ollama: http://127.0.0.1:11434/v1, DeepSeek: https://api.deepseek.com/v1)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# DeepSeek Chat (#/chat) model override. Empty = deepseek-flash on DeepSeek hosts, else OPENAI_MODEL.
YUE_CHAT_MODEL=
# Cam OCR silent fallback (calligraphy / foil). Empty MODEL = fallback off.
# Same API key/base as OPENAI_* by default. Example: deepseek-v4-flash-vision-exp
OPENAI_VISION_API_KEY=
OPENAI_VISION_BASE_URL=
OPENAI_VISION_MODEL=
# Chat image generation — Gemini preferred (shared key → all Family users can generate).
# Google bills image output on the Developer API (free tier no longer includes images).
GEMINI_API_KEY=
# YUE_CHAT_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OpenAI Images fallback (DeepSeek /v1 has no /images). Empty IMAGE_BASE_URL = api.openai.com.
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=
YUE_CHAT_IMAGE_MODEL=dall-e-3
# Generation MCP presets for #/chat Plugins (Adobe-style marketplace).
# OAuth hosts need a Bearer token until per-user OAuth ships — paste from your MCP client session.
# YUE_CHAT_MCP_HIGGSFIELD_URL=https://mcp.higgsfield.ai/mcp
YUE_CHAT_MCP_HIGGSFIELD_TOKEN=
# YUE_CHAT_MCP_ADOBE_URL=https://adobe-creativity.adobe.io/mcp
YUE_CHAT_MCP_ADOBE_TOKEN=
# Cursor remote MCP (coming soon — set when Cursor publishes a hosted generation endpoint)
YUE_CHAT_MCP_CURSOR_URL=
YUE_CHAT_MCP_CURSOR_TOKEN=
# Extra custom MCP servers (JSON array). Same id as a preset overrides that preset.
# YUE_CHAT_MCP_SERVERS=[{"id":"demo","name":"Demo MCP","url":"https://example.com/mcp"}]
YUE_CHAT_MCP_SERVERS=
# Optional AES key material for encrypting per-user Plugins → API keys (BYOK).
# Empty = hash of SUPABASE_SERVICE_ROLE. Apply supabase/migrations/042_chat_plugin_keys.sql.
YUE_CHAT_SECRETS_KEY=
# Optional dedicated HMAC secret for #/chat owner-fallback gate tokens (Family-equivalent chat).
# Empty = derive from YUE_CHAT_SECRETS_KEY / SUPABASE_SERVICE_ROLE. Do not commit real values.
# Dedicated HMAC material for #/chat owner-fallback gate (recommended on Vercel).
# Empty = derive from YUE_CHAT_SECRETS_KEY / SUPABASE_SERVICE_ROLE. On Vercel with
# none of those set, challenge/unlock return 503 chat_gate_misconfigured.
# Challenges are stateless HMAC (safe across serverless instances) — not in-memory.
# YUE_CHAT_GATE_SECRET=
# YUE_CHAT_GATE_CHALLENGE_RL_PER_MIN=20
# YUE_CHAT_GATE_UNLOCK_RL_PER_MIN=8
# words.hk is non-commercial — leave both at 0 for paid/ad-supported deploys
YUE_ALLOW_NONCOMMERCIAL_DICTS=0
YUE_ENABLE_WORDSHK=0
# Code default is YUE_OPEN_MODE=0 (fail-closed: metering + login gates).
# Local lux / private testing: set 1 = Family-like limits, skip metering.
# Production (Vercel): keep 0 (see vercel.json). Omit or set 0 everywhere else.
YUE_OPEN_MODE=1
# Require sign-in before live/Cam when open mode is off (production: 1).
YUE_REQUIRE_LOGIN=1
YUE_FREE_LIVE_MINUTES=60
# Free plan hard cap for tap-to-play TTS (blocks when exhausted).
YUE_FREE_TTS_CHARS=30000
# Monthly Cam scan credits (hard gate). Heartbeat seconds are admin logging only.
YUE_FREE_CAMERA_SCANS=120
YUE_FREE_DOCS_PAGES=40
# Hard monthly caps for multimodal LLM OCR fallback (Cam + Documents). Generous; stops burn attacks.
YUE_FREE_AI_VISION_COUNT=200
YUE_FAMILY_AI_VISION_COUNT=2000
YUE_BUSINESS_AI_VISION_COUNT=10000
# DeepSeek general chat (#/chat) — Family/Business. 0 = unlimited turns.
YUE_FAMILY_CHAT_TURNS=3000
YUE_BUSINESS_CHAT_TURNS=0
YUE_CHAT_RL_PER_MIN=40
# Chat Inbox internal sandbox (Phase C). Default stub = in-process temp dir (no billing).
# Real Fly Machines: set YUE_SANDBOX_DRIVER=fly + FLY_API_TOKEN + FLY_APP (server fallback).
# Prefer per-user BYO under Plugins → API keys: key ids `fly` + `fly_app` (chat_plugin_keys vault).
YUE_SANDBOX_DRIVER=stub
# FLY_API_TOKEN=
# FLY_APP=
# FLY_REGION=sjc
# FLY_IMAGE=node:22-bookworm-slim
# Chat Inbox GitHub (Phase E) — GitHub App preferred. NEEDS_HUMAN: create App + install on repos.
# Permissions: Contents read/write, Pull requests read/write, Metadata read.
# Prefer per-user BYO under Plugins → API keys:
#   github_app_id, github_app_private_key, github_app_installation_id
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_INSTALLATION_ID=
# Extra CORS Origins (comma-separated). Usually leave unset — www + apex +
# https://jyuttranslate.vercel.app + localhost are already covered.
# YUE_CORS_ORIGINS=
YUE_FREE_ALLOW_LIVE=1
YUE_FREE_ALLOW_TTS=1
YUE_FREE_ALLOW_CAMERA=1
YUE_GUEST_LIVE_MINUTES=0
YUE_GUEST_CAMERA_SCANS=30
# Family plan (legacy YUE_PRO_* / YUE_*_CAMERA_MINUTES still accepted as scan fallback)
YUE_FAMILY_CAMERA_SCANS=800
YUE_FAMILY_LIVE_MINUTES=480
YUE_FAMILY_DOCS_PAGES=400
# Retained for reference; Family/Business TTS is unlimited in entitlements (admin shows 0 cap).
YUE_FAMILY_TTS_CHARS=200000
# Business plan (legacy YUE_MAX_* / STRIPE_PRICE_MAX_* still accepted)
YUE_BUSINESS_LIVE_MINUTES=2400
YUE_BUSINESS_TTS_CHARS=500000
# Public app URL for login/upgrade links, Stripe redirects, and CORS (± www).
# Production canonical: https://www.jyuttranslate.com (apex → www via vercel.json).
YUE_APP_URL=http://localhost:5173
# Supabase (API uses service role; web uses anon key via VITE_* or runtime /api/auth-config)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=
# Same value as VITE_SUPABASE_ANON_KEY — lets the API hand the public key to the web app
SUPABASE_ANON_KEY=
# Stripe Checkout + webhook (legacy STRIPE_PRICE_PRO_* still accepted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY_MONTH=
STRIPE_PRICE_FAMILY_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
# Legacy Stripe price env names (STRIPE_PRICE_PRO_*, STRIPE_PRICE_MAX_*) still accepted
# Comma-separated admin emails for #/admin (case-insensitive)
YUE_ADMIN_EMAILS=
# Admin email alerts (Resend) — sign-ups & upgrades
RESEND_API_KEY=
# Resend Audience id — Dashboard → Audiences (contacts sync on sign-up & sign-in)
RESEND_AUDIENCE_ID=
# Verified sender in Resend — must include @:  Name <noreply@yourdomain.com>
# Wrong: JyutTranslate <noreply.yourdomain.com>  (domain without @)
# Right: JyutTranslate <noreply@yourdomain.com>  (or onboarding@resend.dev for tests)
YUE_NOTIFY_FROM=
# Support / Reply-To (O365 help@). Default: JyutTranslate Help <help@jyuttranslate.com>
# Does not need to match the Resend From domain — replies go to your Help inbox.
YUE_SUPPORT_FROM=JyutTranslate Help <help@jyuttranslate.com>
# Optional — defaults to YUE_ADMIN_EMAILS
YUE_ADMIN_NOTIFY_EMAILS=
# Secret for Supabase Database Webhook fallback (optional — many projects lack supabase_functions)
YUE_NOTIFY_WEBHOOK_SECRET=
# Supabase Auth Hook secret (Authentication → Hooks → Before user created) — recommended
SUPABASE_AUTH_HOOK_SECRET=
# Send Email hook (user confirm / magic link / recovery) — separate secret from above
SUPABASE_SEND_EMAIL_HOOK_SECRET=

# Web Push (PWA notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:help@jyuttranslate.com
