PORT=8787
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# Chat / translation backend (OpenAI SDK — works with OpenAI or compatible hosts)
OPENAI_API_KEY=
# Optional. Omit for OpenAI cloud. Examples:
#   Ollama:     http://127.0.0.1:11434/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Together:   https://api.together.xyz/v1
OPENAI_BASE_URL=
# Model id as known by the host (OpenAI: gpt-4o-mini · Ollama: your pulled tag)
OPENAI_MODEL=gpt-4o-mini

# --- Ollama example ---
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=cantonesellmchat   # use the exact name from `ollama list`

YUE_OPEN_MODE=1
YUE_FREE_LIVE_MINUTES=20
YUE_FREE_TTS_CHARS=0
YUE_FREE_ALLOW_LIVE=1
YUE_FREE_ALLOW_TTS=0
