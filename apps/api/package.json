{
  "name": "@yue/api",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "_comment": "Keep dependencies in sync with /api/package.json (Vercel serverless bundle).",
  "scripts": {
    "predev": "node ../../scripts/compile-api-emails.mjs",
    "prestart": "node ../../scripts/compile-api-emails.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "compile:emails": "node ../../scripts/compile-api-emails.mjs",
    "smoke:canto": "tsx src/canto/smoke.ts",
    "smoke:entitlements": "tsx src/entitlements.smoke.ts",
    "smoke:usage": "tsx src/usage.smoke.ts",
    "smoke:household-usage": "tsx src/household.usage.smoke.ts",
    "smoke:all": "npm run smoke:entitlements && npm run smoke:usage && npm run smoke:household-usage && npm run smoke:canto",
    "import:cc-canto": "tsx scripts/import-cc-canto.ts",
    "import:wordshk": "tsx scripts/import-wordshk.ts"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^1.4.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "openai": "^4.77.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^4.8.0",
    "standardwebhooks": "^1.0.0",
    "stripe": "^17.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
