# Optional external deep links (baked in at build time).
# Prefer editing public/site-config.json (copied to dist/) so you can change
# URLs on the server without rebuilding.

# External translator URL (rare — normally use in-app #/app)
# VITE_TRANSLATOR_URL=https://www.jyuttranslate.com/#/app

# External pricing / checkout URL
# VITE_PRICING_URL=https://www.jyuttranslate.com/#/pricing

# External marketing site (back-link from the app)
# VITE_MARKETING_URL=https://www.jyuttranslate.com/

# Supabase Auth (Vercel launch)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=
#
# Enable Google under Supabase → Authentication → Providers, then add this app URL
# (and http://localhost:5173/#/app for local dev) under Authentication → URL configuration.
#
# Apple: enable the Apple provider in Supabase once your Apple Developer account is ready.
# Create a Services ID + Sign in with Apple key in Apple Developer, then paste the
# client IDs / secret key / key ID into Supabase → Authentication → Providers → Apple.
