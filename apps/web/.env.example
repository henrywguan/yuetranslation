# Optional hybrid Bluehost links (baked in at build time).
# Prefer editing public/site-config.json (copied to dist/) so you can change
# URLs on the server without rebuilding.

# Bricks (or WP) page that embeds [yue_translator]
# VITE_TRANSLATOR_URL=https://yoursite.com/translate

# Pricing / MemberPress checkout
# VITE_PRICING_URL=https://yoursite.com/pricing

# Static marketing site (back-link from the app when not embedded)
# VITE_MARKETING_URL=https://yoursite.com/
