{
  "version": 1,
  "purpose": "Offline fixtures for Cam AR / Upload / Documents accuracy. Do not commit live API outputs. Score OCR+MT separately.",
  "howToTest": {
    "documents": "Cam → Documents → upload each file under fixtures/cam-accuracy/documents/",
    "signs": "Cam → Upload image → open each PNG under fixtures/cam-accuracy/signs/ → Auto-detect or draw boxes → Translate",
    "ar": "Display a sign PNG fullscreen on a second device / print it, then Cam → AR → shutter",
    "scoring": "Compare OCR text to sourceText (character/word error). Compare translation to expectedHints (meaning, not verbatim). Prefer Traditional Chinese for EN→zh output."
  },
